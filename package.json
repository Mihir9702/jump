{
  "name": "jump",
  "version": "2.0.0-rc.1",
  "private": true,
  "description": "A small 2.5D platformer about a cyan cube, built with Three.js.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "playtest": "node tools/playtest.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
